# =====================================================================
# Smart Study Planner V3.0 · 正式部署环境变量模板（A7.1 候选）
# ---------------------------------------------------------------------
# 使用方式：
#   1. 复制为 .env（不要提交到版本库）；
#   2. 将所有 change-me / 占位值替换为正式值；
#   3. 本地 HTTP 开发与正式 HTTPS 部署必须使用不同的
#      REFRESH_COOKIE_SECURE 与 AUTH_ALLOWED_ORIGINS 配置。
# 注意：本文件不含任何真实密钥，仅用于部署准备。
# =====================================================================

# ---------------------------------------------------------------------
# 1. MySQL 连接
# ---------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=ssp_app
DB_PASSWORD=change-me-strong-db-password
# 正式库名（A7 确认为 smart_study_planner）
DB_NAME=smart_study_planner

# ---------------------------------------------------------------------
# 2. JWT 密钥与有效期
#    两个密钥均要求 >= 32 字节，且必须互不相同。
# ---------------------------------------------------------------------
SECRET_KEY=change-me-32bytes-minimum-jwt-secret
EMAIL_CODE_SECRET=change-me-32bytes-minimum-email-secret
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# 登录会话（滑动空闲 + 绝对过期）
SESSION_IDLE_EXPIRE_DAYS=7
SESSION_ABSOLUTE_EXPIRE_DAYS=30
SESSION_ACTIVITY_INTERVAL_SECONDS=300

# ---------------------------------------------------------------------
# 3. Refresh Cookie
#    正式 HTTPS 必须为 true；本地 HTTP 开发可临时设为 false。
# ---------------------------------------------------------------------
REFRESH_COOKIE_NAME=ssp_refresh
REFRESH_COOKIE_PATH=/auth
REFRESH_COOKIE_SECURE=true

# ---------------------------------------------------------------------
# 4. CORS / Origin 白名单（JSON 数组，不要包含 localhost）
# ---------------------------------------------------------------------
AUTH_ALLOWED_ORIGINS=["https://your-domain.example"]

# ---------------------------------------------------------------------
# 5. 邮箱验证码与 SMTP/Brevo 邮件服务
#    MAIL_ENABLED=false 时不会发送真实邮件（本地开发用）。
# ---------------------------------------------------------------------
MAIL_ENABLED=false
BREVO_API_KEY=
MAIL_FROM_EMAIL=no-reply@your-domain.example
MAIL_FROM_NAME=Smart Study Planner
MAIL_TIMEOUT_SECONDS=10

EMAIL_CODE_EXPIRE_MINUTES=5
EMAIL_CODE_COOLDOWN_SECONDS=60
EMAIL_CODE_MAX_ATTEMPTS=5
EMAIL_DAILY_LIMIT=10
EMAIL_IP_DAILY_LIMIT=30
EMAIL_GLOBAL_DAILY_LIMIT=80

# ---------------------------------------------------------------------
# 6. 认证限流与账号锁定
# ---------------------------------------------------------------------
AUTH_IP_WINDOW_MINUTES=15
PASSWORD_IP_MAX_ATTEMPTS=30
EMAIL_CODE_IP_MAX_ATTEMPTS=30
AUTH_LOCK_TIMEOUT_SECONDS=3
PASSWORD_MAX_FAILED_ATTEMPTS=5
PASSWORD_LOCK_MINUTES=15
AUTH_EVENT_RETENTION_DAYS=30
# 正式环境是否启用过期认证事件清理任务
AUTH_CLEANUP_ENABLED=false

# ---------------------------------------------------------------------
# 7. 头像存储（需纳入备份，且不要放在 Web 根目录）
# ---------------------------------------------------------------------
AVATAR_MAX_BYTES=2097152
AVATAR_MAX_SIZE=512
AVATAR_MAX_PIXELS=16000000
# AVATAR_DIR=/var/lib/ssp/storage/avatars

# ---------------------------------------------------------------------
# 8. DeepSeek Provider / AI 基础配置
#    AI_ENABLED 为历史兼容字段，运行时准入以 ai_runtime_config 为准。
# ---------------------------------------------------------------------
AI_ENABLED=false
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

AI_MAX_NOTE_CHARS=12000
AI_MAX_OUTPUT_CHARS=12000
AI_STREAM_CHUNK_CHARS=240
AI_MAX_OUTPUT_TOKENS=3500

# ---------------------------------------------------------------------
# 9. AI 每日额度（默认值；运行时以管理端 ai_runtime_config 为准）
# ---------------------------------------------------------------------
AI_USER_DAILY_LIMIT=10
AI_GLOBAL_DAILY_LIMIT=80

# 开发者硬上限（不可被管理端突破）
AI_USER_DAILY_HARD_LIMIT=50
AI_GLOBAL_DAILY_HARD_LIMIT=200

# ---------------------------------------------------------------------
# 10. AI 并发与租约
#     租约必须大于最大流式时长。
# ---------------------------------------------------------------------
AI_USER_CONCURRENCY=1
AI_GLOBAL_CONCURRENCY=2
AI_MAX_STREAM_SECONDS=120
AI_LEASE_SECONDS=180

# ---------------------------------------------------------------------
# 11. Redis（正式实例须内网访问、requirepass、独立 DB 号）
# ---------------------------------------------------------------------
REDIS_URL=redis://:change-me-redis-password@127.0.0.1:6379/0

# AI 请求频率限制（精确滑动窗口）
AI_USER_RATE_LIMIT=6
AI_RATE_WINDOW_SECONDS=60